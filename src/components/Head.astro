---
import { site } from '../data/site';
import displayFont from '../assets/fonts/bricolage-grotesque-latin-wght.woff2?url';
import bodyFont from '../assets/fonts/instrument-sans-latin-wght.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Load boot.js (theme + view before paint). Off for the script-free /llm page. */
  scripts?: boolean;
  noindex?: boolean;
  jsonLd?: object;
}

const {
  title,
  description = site.description,
  scripts = true,
  noindex = false,
  jsonLd,
} = Astro.props;
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
<link
  rel="alternate"
  type="text/markdown"
  href="/portfolio.md"
  title={`${site.name}: portfolio as Markdown`}
/>
<link rel="alternate" type="application/json" href="/content.json" title="Portfolio as JSON" />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name}: ${site.roleLine}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

{scripts && (
  <>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <script is:inline src="/boot.js" />
  </>
)}
{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
)}
