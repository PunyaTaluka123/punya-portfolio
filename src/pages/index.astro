---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const words = site.name.split(' ');
const total = String(site.projects.length).padStart(2, '0');
const pad = (n: number) => String(n).padStart(2, '0');
const ext = { rel: 'noopener noreferrer', target: '_blank' };
const [emailUser, emailHost] = site.email.split('@');

// Experience orbit: roles sit on a circle. A role in the lower half opens its
// comment box above itself, so the box stays on the page.
const n = site.experience.length;
const opensAbove = (i: number) => Math.sin(((i / n) * 360 - 90) * (Math.PI / 180)) > 0.25;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  description: site.roleLine,
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.schoolFull },
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  sameAs: [site.links.github, site.links.linkedin],
  knowsAbout: site.interests,
};
---

<Base title={`${site.name}: Data Science and AI student, computer vision`} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-name">
    <canvas class="field" aria-hidden="true"></canvas>
    <p class="rail rail-top mono">
      {site.copy.railTop.map((t) => (
        <span>{t}</span>
      ))}
    </p>
    <!-- One copy of the name: letters are split for the stagger, aria-label keeps it whole. -->
    <h1 id="hero-name" class="hero-name" aria-label={site.name}>
      {words.map((word, w) => (
        <>
          {w > 0 && ' '}
          <span class="word">
            {[...word].map((ch) => (
              <span class="ch">{ch}</span>
            ))}
          </span>
        </>
      ))}
    </h1>
    <div class="hero-meta">
      <p class="role">{site.roleLine}</p>
      <p class="cta">
        <a class="btn btn-solid" href="#projects">
          {site.copy.ctaProjects}
        </a>
        <a class="btn" href={`mailto:${site.email}`}>
          {site.copy.ctaEmail}
        </a>
      </p>
    </div>
    <p class="rail rail-bottom mono">
      {site.copy.railBottom.map((t) => (
        <span>{t}</span>
      ))}
    </p>
  </section>

  <section id="about" class="section" aria-labelledby="about-h">
    <div class="sec-head">
      <span class="mono">01</span>
      <h2 id="about-h">About</h2>
    </div>
    <div class="sec-body about-body">
      <p class="lead">{site.about[1]}</p>
      <div class="about-grid">
        <div class="prose reveal">
          <p>{site.about[0]}</p>
          {site.about.slice(2).map((p) => (
            <p>{p}</p>
          ))}
          <p class="availability">{site.availability}</p>
        </div>
        <dl class="facts reveal">
          <div>
            <dt class="mono">Education</dt>
            {site.education.map((e) => (
              <>
                <dd>
                  <strong>{e.school}</strong>
                  {e.when && `, ${e.when}`}
                </dd>
                <dd>{e.detail}</dd>
              </>
            ))}
          </div>
          <div>
            <dt class="mono">Recognition</dt>
            {site.recognition.map((r) => (
              <dd>{r}</dd>
            ))}
          </div>
          <div>
            <dt class="mono">Languages I speak</dt>
            <dd>{site.spoken.join(', ')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="experience" class="section xp-section" aria-labelledby="xp-h">
    <div class="orbit">
      <div class="orbit-core sec-head">
        <span class="mono">02</span>
        <h2 id="xp-h">Experience</h2>
        <p class="mono hint" aria-hidden="true">
          {site.copy.experienceHint}
        </p>
      </div>
      <ol class={`orbit-list n-${n}`}>
        {site.experience.map((x, i) => (
          <li class:list={['orbit-item', opensAbove(i) ? 'opens-above' : 'opens-below']}>
            <button class="orbit-title" type="button" popovertarget={`xp-${i}`}>
              {x.when && <span class="mono when">{x.when}</span>}
              <span class="role">{x.role}</span>
              <span class="org">{x.org}</span>
            </button>
            <div id={`xp-${i}`} class="xp-pop" popover>
              <h3>
                {x.role}
                <span class="org">
                  <span class="sep">{' · '}</span>
                  {x.org}
                </span>
              </h3>
              {x.when && <p class="mono when">{x.when}</p>}
              <ul>
                {x.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
              <button
                class="pop-close"
                type="button"
                popovertarget={`xp-${i}`}
                popovertargetaction="hide"
                aria-label={`Close ${x.role}, ${x.org}`}
              >
                ×
              </button>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="projects" class="section projects" aria-labelledby="projects-h">
    <div class="sec-head">
      <span class="mono">03</span>
      <h2 id="projects-h">Projects</h2>
    </div>
    <div class="progress mono" aria-hidden="true">
      <span class="track">
        <span class="fill"></span>
      </span>
      <ol>
        {site.projects.map((_, i) => (
          <li>{pad(i + 1)}</li>
        ))}
      </ol>
    </div>
    <div class="sec-body">
      <ol class="stack">
        {site.projects.map((p, i) => (
          <li class="card">
            <article aria-labelledby={`card-${p.slug}`}>
              <span class="bracket b-tl" aria-hidden="true" />
              <span class="bracket b-tr" aria-hidden="true" />
              <span class="bracket b-bl" aria-hidden="true" />
              <span class="bracket b-br" aria-hidden="true" />
              <span class="det mono" aria-hidden="true">
                {pad(i + 1)} · {p.tags[0]}
              </span>
              <p class="card-top mono">
                <span>
                  {pad(i + 1)} / {total}
                </span>
                <span>{p.tags.join(' · ')}</span>
              </p>
              <h3 class="card-title" id={`card-${p.slug}`} data-vt={`project-${i + 1}`}>
                <a href={`/projects/${p.slug}`}>{p.name}</a>
              </h3>
              <div class="card-foot">
                <p>{p.oneLine}</p>
                <span class="more mono" aria-hidden="true">
                  Read more →
                </span>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
    <p class="others">
      Also:{' '}
      {site.otherProjects.map((name, i) => (
        <>
          <strong>{name}</strong>
          {i < site.otherProjects.length - 1 ? ', ' : '.'}
        </>
      ))}
    </p>
  </section>

  <section id="skills" class="section" aria-labelledby="skills-h">
    <div class="sec-head">
      <span class="mono">04</span>
      <h2 id="skills-h">Skills</h2>
    </div>
    <div class="sec-body skills reveal">
      <div>
        <h3>Languages</h3>
        <ul class="big-list">
          {site.skills.languages.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Areas</h3>
        <ul class="mid-list">
          {site.skills.areas.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>ML libraries</h3>
        <ul class="mid-list">
          {site.skills.ml.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Tools</h3>
        <ul class="chip-list">
          {site.skills.tools.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Interests</h3>
        <ul class="chip-list">
          {site.interests.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-h">
    <div class="sec-head">
      <span class="mono">05</span>
      <h2 id="contact-h">Contact</h2>
    </div>
    <div class="sec-body prose contact-body reveal">
      <p class="lead">{site.copy.contactLead}</p>
      <p>
        <!-- prettier-ignore -->
        <a class="contact-email" href={`mailto:${site.email}`}>{emailUser}<wbr />@{emailHost}</a>
      </p>
      <ul class="contact-links">
        <li>
          <a class="draw" href={site.links.github} {...ext}>
            GitHub: {site.handles.github}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a class="draw" href={site.links.linkedin} {...ext}>
            LinkedIn: {site.handles.linkedin}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>
